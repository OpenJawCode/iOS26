{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev.ios26/schemas/tokens.schema.json",
  "title": "DesignTokens",
  "description": "Design token document (D-P2.4). Source of truth for the generated Tokens.kt.",
  "type": "object",
  "properties": {
    "meta": { "type": "object" },
    "color": {
      "type": "object",
      "properties": {
        "core": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" } }
      },
      "required": ["core"]
    },
    "semantic": {
      "type": "object",
      "properties": {
        "light": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" } },
        "dark": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" } }
      },
      "required": ["light", "dark"]
    },
    "type": { "type": "object" },
    "spacing": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9]+dp$" } },
    "radius": { "type": "object" },
    "elevation": { "type": "object" },
    "blur": { "type": "object", "additionalProperties": { "type": "integer" } },
    "zIndex": { "type": "object", "additionalProperties": { "type": "integer" } },
    "grid": { "type": "object" },
    "motion": { "type": "object" },
    "haptics": { "type": "object" }
  },
  "required": ["meta", "color", "semantic", "type", "spacing", "radius", "elevation", "blur", "zIndex", "grid", "motion", "haptics"]
}
